# Обязательно: токен от @BotFather
BOT_TOKEN=YOUR_TOKEN

# Необязательно: Telegram ID администраторов через запятую
ADMIN_IDS=

# Публичный HTTPS-адрес этого же приложения
PUBLIC_BASE_URL=https://example.com

# RollyPay (оставьте пустыми, чтобы скрыть способ оплаты)
ROLLYPAY_API_BASE=https://api.rollypay.io
ROLLYPAY_TERMINAL_ID=
ROLLYPAY_API_KEY=
ROLLYPAY_SIGNING_SECRET=
ROLLYPAY_TEST_MODE=true

# Обычно менять не нужно
WEB_HOST=0.0.0.0
WEB_PORT=8080
